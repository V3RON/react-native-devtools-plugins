          "content": {
            "size": 636,
            "mimeType": "text/html",
            "compression": 0,
            "text": "<!doctype html><title>electron-leftovers target</title>\n<script>\n  // Keeps logging and fetching, so the DevTools console and network panel have live\n  // content whenever the frontend attaches.\n  let n = 0;\n  const tick = () => {\n    n += 1;\n    console.log(\"leftovers: hello from the inspected page #\" + n);\n    if (n % 3 === 0) console.warn(\"leftovers: a warning line #\" + n);\n    if (n % 5 === 0) console.error(\"leftovers: an error line #\" + n);\n    fetch(\"/data.json?n=\" + n)\n      .then((r) => r.json())\n      .then((j) => console.log(\"leftovers: fetched\", JSON.stringify(j)));\n  };\n  tick();\n  setInterval(tick, 1500);\n</script>\n"
          },
          "redirectURL": "",
          "headersSize": 187,
          "bodySize": 636,
          "_transferSize": 823,
